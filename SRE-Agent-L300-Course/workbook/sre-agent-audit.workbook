{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "param-threadid",
            "version": "KqlParameterItem/1.0",
            "name": "ThreadId",
            "label": "Thread ID",
            "type": 1,
            "description": "Filter events by a specific thread/conversation ID",
            "isRequired": false,
            "value": ""
          },
          {
            "id": "param-lookbackdays",
            "version": "KqlParameterItem/1.0",
            "name": "lookbackDays",
            "label": "Lookback Days",
            "type": 1,
            "description": "Number of days to look back for data",
            "isRequired": true,
            "value": "30"
          },
          {
            "id": "param-agentname",
            "version": "KqlParameterItem/1.0",
            "name": "agentName",
            "label": "Agent Name",
            "type": 1,
            "description": "Filter by custom agent name",
            "isRequired": false,
            "value": ""
          }
        ],
        "style": "pills",
        "queryType": 0
      },
      "name": "parameters"
    },
    {
      "type": 1,
      "content": {
        "json": "# SRE Agent Audit Workbook\n\nThis workbook provides 5 KQL queries for auditing SRE Agent activity, aligned with the Lab 10 audit and observability objectives.\n\nUse the parameters above to filter by **Thread ID**, **lookback period**, and **agent name**."
      },
      "name": "header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Query 1: Per-thread replay — full event stream for a given ThreadId\n// Maps to Lab 10 outcome: trace correlation across MetaAgent → AgentHandoff → AgentToolExecution → ModelGeneration → AgentResponse\ncustomEvents\n| where timestamp > ago(toint('{lookbackDays}')* 1d)\n| where isempty('{ThreadId}') or tostring(customDimensions.ThreadId) == '{ThreadId}'\n| where isempty('{agentName}') or tostring(customDimensions.AgentName) == '{agentName}'\n| project\n    timestamp,\n    name,\n    ThreadId = tostring(customDimensions.ThreadId),\n    TraceId = tostring(customDimensions.TraceId),\n    AgentName = tostring(customDimensions.AgentName),\n    ToolName = tostring(customDimensions.ToolName),\n    EventType = tostring(customDimensions.EventType),\n    Status = tostring(customDimensions.Status),\n    Duration = todouble(customDimensions.Duration),\n    Message = tostring(customDimensions.Message)\n| order by timestamp asc",
        "size": 0,
        "title": "1. Per-Thread Replay",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "table",
        "gridSettings": {
          "sortBy": [
            {
              "itemKey": "timestamp",
              "sortOrder": 1
            }
          ]
        }
      },
      "name": "query-per-thread-replay"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Query 2: Top tools last N days — AgentToolExecution ToolStart, summarized by ToolName\n// Maps to Lab 10 outcome: understand which tools are most used and optimize tool budgets\ncustomEvents\n| where timestamp > ago(toint('{lookbackDays}') * 1d)\n| where name == 'AgentToolExecution'\n| where tostring(customDimensions.EventType) == 'ToolStart'\n| where isempty('{agentName}') or tostring(customDimensions.AgentName) == '{agentName}'\n| where isempty('{ThreadId}') or tostring(customDimensions.ThreadId) == '{ThreadId}'\n| summarize\n    ExecutionCount = count(),\n    AvgDuration = avg(todouble(customDimensions.Duration)),\n    DistinctThreads = dcount(tostring(customDimensions.ThreadId))\n    by ToolName = tostring(customDimensions.ToolName)\n| order by ExecutionCount desc\n| take 50",
        "size": 0,
        "title": "2. Top Tools (Last {lookbackDays} Days)",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "barchart"
      },
      "name": "query-top-tools"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Query 3: Token cost by custom agent — ModelGeneration ModelGenerationEnd\n// Maps to Lab 10 outcome: FinOps overlay — map model tier choices to spend\ncustomEvents\n| where timestamp > ago(toint('{lookbackDays}') * 1d)\n| where name == 'ModelGeneration'\n| where tostring(customDimensions.EventType) == 'ModelGenerationEnd'\n| where isempty('{agentName}') or tostring(customDimensions.AgentName) == '{agentName}'\n| where isempty('{ThreadId}') or tostring(customDimensions.ThreadId) == '{ThreadId}'\n| summarize\n    TotalInputTokens = sum(toint(customDimensions.InputTokens)),\n    TotalOutputTokens = sum(toint(customDimensions.OutputTokens)),\n    TotalTokens = sum(toint(customDimensions.InputTokens) + toint(customDimensions.OutputTokens)),\n    CallCount = count()\n    by\n    AgentName = tostring(customDimensions.AgentName),\n    ModelId = tostring(customDimensions.ModelId)\n| extend EstimatedCostUSD = round(TotalTokens * 0.00001, 4)\n| order by TotalTokens desc",
        "size": 0,
        "title": "3. Token Cost by Custom Agent",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "table"
      },
      "name": "query-token-cost"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Query 4: Incident outcomes last N days — IncidentActivitySnapshot\n// Maps to Lab 10 outcome: measure agent effectiveness across response plans\ncustomEvents\n| where timestamp > ago(toint('{lookbackDays}') * 1d)\n| where name == 'IncidentActivitySnapshot'\n| where isempty('{agentName}') or tostring(customDimensions.AgentName) == '{agentName}'\n| where isempty('{ThreadId}') or tostring(customDimensions.ThreadId) == '{ThreadId}'\n| project\n    timestamp,\n    MitigatedByAgent = tostring(customDimensions.MitigatedByAgent),\n    AssistedByAgent = tostring(customDimensions.AssistedByAgent),\n    Autonomy = tostring(customDimensions.Autonomy),\n    ResponsePlanId = tostring(customDimensions.ResponsePlanId),\n    Severity = tostring(customDimensions.Severity),\n    ResolutionTime = todouble(customDimensions.ResolutionTimeMinutes),\n    AgentName = tostring(customDimensions.AgentName)\n| summarize\n    TotalIncidents = count(),\n    Mitigated = countif(MitigatedByAgent == 'true'),\n    Assisted = countif(AssistedByAgent == 'true'),\n    AvgResolutionMin = avg(ResolutionTime)\n    by ResponsePlanId, Autonomy\n| extend MitigationRate = round(100.0 * Mitigated / TotalIncidents, 1)\n| order by TotalIncidents desc",
        "size": 0,
        "title": "4. Incident Outcomes (Last {lookbackDays} Days)",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "table"
      },
      "name": "query-incident-outcomes"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "// Query 5: Approval rate per approver — ApprovalDecision\n// Maps to Lab 10 outcome: track approval behavior, identify bottlenecks\ncustomEvents\n| where timestamp > ago(toint('{lookbackDays}') * 1d)\n| where name == 'ApprovalDecision'\n| where isempty('{agentName}') or tostring(customDimensions.AgentName) == '{agentName}'\n| where isempty('{ThreadId}') or tostring(customDimensions.ThreadId) == '{ThreadId}'\n| extend\n    Approver = tostring(customDimensions.Approver),\n    Decision = tostring(customDimensions.Decision),\n    AgentName = tostring(customDimensions.AgentName)\n| summarize\n    TotalDecisions = count(),\n    Approved = countif(Decision == 'approve'),\n    Rejected = countif(Decision == 'reject')\n    by Approver\n| extend ApprovalRate = round(100.0 * Approved / TotalDecisions, 1)\n| order by TotalDecisions desc",
        "size": 0,
        "title": "5. Approval Rate per Approver",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "table"
      },
      "name": "query-approval-rate"
    }
  ],
  "fallbackResourceIds": [],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
